/*
 * Porites sp. Indonesia (isolate ID_GA_Por_15) on BinAC2: conf/porites.config with the BinAC2 paths.
 * Run from inside the repo (on BinAC2: /pfs/10/work/kn_pop537927-Genome-Maker); the data folders
 * inputs/, db/ and conf/ sit in the repo folder there, so every path is ${projectDir}/...
 *
 *   nextflow run main.nf -profile binac2 -c conf/porites_binac2.config -w work --outdir results
 */

params {
    // ---- inputs: raw Canu contigs; purge_dups and RagTag run inside the pipeline
    input_assembly         = "${projectDir}/inputs/canu_2.contigs.fasta"
    ont_raw_reads          = "${projectDir}/inputs/Por_GA_15_allrun.fastq.gz"
    rnaseq_dir             = "${projectDir}/inputs/rna_dir_pool"
    protein_refs           = "${projectDir}/db/protein_refs/Metazoa.fa"
    trimmomatic_adapters   = "${projectDir}/inputs/all_truseq_edited.fasta"
    mito_ref               = "${projectDir}/inputs/mito-Plut_OY283138.1.fasta"
    mito_annot_ref_fasta   = "${projectDir}/inputs/mito_ref/NC_029695.1.fasta"
    mito_annot_ref_gff     = "${projectDir}/inputs/mito_ref/NC_029695.1.gff3"

    // ---- databases
    busco_offline_dir      = "${projectDir}/db/busco_db"
    blast_db               = "${projectDir}/db/core_nt"
    blast_taxdump          = "${projectDir}/db/new_taxdump"
    diamond_db             = "${projectDir}/db/uniprot/reference_proteomes.dmnd"
    funannotate_db         = "${projectDir}/db/funannotate_DB"
    eggnog_db              = "${projectDir}/db/eggnog_DB"
    interproscan_data      = "${projectDir}/db/interproscan-5.73-104.0/data"
    phobius_dir            = "${projectDir}/db/phobius"
    omamer_db              = "${projectDir}/db/omamer/Metazoa.h5"
    rfam_cm                = "${projectDir}/db/rfam/Rfam.cm"
    rfam_clanin            = "${projectDir}/db/rfam/Rfam.clanin"
    rfam_family            = "${projectDir}/db/rfam/family.txt"
    getorganelle_db_dir    = "${projectDir}/db/getorganelle_db"
    rm_libraries           = "${projectDir}/db/rm_libraries/Libraries"   // Dfam 3.9 partitions 0 + 16
    related_proteomes      = "${projectDir}/db/related_proteomes"
    symbiont_busco_lineage = "${projectDir}/db/busco/alveolata_odb12.2026-05-22.tar.gz"

    // ---- BRAKER4 (outside the containers)
    braker4_snakemake_env  = "/home/kn/kn_kn/kn_pop537927/.conda/envs/snakemake"
    braker4_executor       = 'slurm'   // each BRAKER4 rule its own SLURM job; 'local' = all rules in one job
    braker4_slurm_cpus     = 64        // half a compute node (96 or 128 CPUs, ~511 GB), so rules start without a free node
    braker4_slurm_mem_mb   = 192000    // multi-threaded rules get this; single-threaded rules get this / cpus (3 GB)
    funannotate_force      = true      // 5 short simple-repeat scaffolds use 3 bases (no genes on them)
    braker4_force_augustus = true     // TSEBRA kept 17,185 genes; forced AUGUSTUS + TSEBRA's merge: 37,086 (docs/force_step_fix.md)

    // ---- purge_dups: single merged depth peak (~16x), so calcuts cannot place the transition.
    // Tested on the raw contigs (release/stageA/raw_canu): transition 10 is best.
    purge_dups_lower       = 5
    purge_dups_transition  = 10
    purge_dups_upper       = 72

    // ---- contamination screens
    run_screens            = true
    univec                 = "${projectDir}/db/univec/UniVec_Core"
    fcs_gx_db              = "${projectDir}/db/fcs_gx_db"
    fcs_adaptor_image      = "${projectDir}/db/fcs_images/fcs-adaptor_0.5.5.sif"
    fcs_gx_image           = "${projectDir}/db/fcs_images/fcs-gx_0.5.5.sif"
    // Genus Porites: the species taxid 3903096 is newer than the GX database (build 2023-01-24).
    taxon_id               = 46719
    screen_decisions       = "${projectDir}/conf/porites_screen_decisions_v1.2.tsv"
    transcript_edits       = "${projectDir}/conf/porites_transcript_edits_v1.2.tsv"
    product_draft          = "${projectDir}/conf/porites_product_draft_v1.2.tsv"
    // UniProt lookups of the local curation test (release 2026_04): the release run makes no new queries
    product_cache          = "${projectDir}/conf/porites_uniprot_cache_2026_04.json"
    // gene symbols without funannotate's '_N' copy suffix (NCBI: /gene is the gene symbol; locus_tag is the unique ID)
    strip_gene_suffix      = true

    // ---- RagTag 2.1.0, defaults, against P. lutea
    scaffold_reference     = "${projectDir}/inputs/Plobata1_GCA_973946955.1.fna"
    // scaffold_reference     = "${projectDir}/inputs/Plutea2_GCF_958299795.1.fna"
    ragtag_infer_gaps      = false

    // ---- refinement
    n_chromosome_scaffolds = 14
    run_haplotig_scan      = true

    // ---- release curation
    run_release            = true
    release_name           = 'Porites_sp_v1.2'
    version                = '1.2'
    table2asn              = "${projectDir}/db/table2asn/linux64.table2asn.gz"
    ncbi_species           = 'Porites sp. Indonesia'
    ncbi_isolate           = 'ID_GA_Por_15'
    locus_tag              = 'ADA42R'
    ncbi_sbt               = "${projectDir}/conf/template.sbt"
    ncbi_cmt               = "${projectDir}/conf/genome_structured_comment.cmt"
    bioproject             = 'PRJNA1548328'
    biosample              = 'SAMN49911241'
    qc_expected_lineage    = 'Eukaryota; Metazoa; Cnidaria'
    qc_expected_division   = 'INV'
    qc_chrom_prefix        = 'OZ' // was NC_ is dependent on reference used.
}
