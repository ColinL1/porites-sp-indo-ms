params {
    new_name            = 'Porites_sp_nov_indonesia'
    new_fasta           = "${projectDir}/../data/results_v1.2/release_curation/Porites_sp_v1.2/genome/Porites_sp._Indonesia_ID_GA_Por_15.scaffolds.fa"   // final assembly; BUSCO is run on it
    new_busco_dir       = null       // or an existing BUSCO genome-mode output for it
    references          = "${projectDir}/references.tsv"   // name, busco_dir, small, large
    outgroup            = 'Amuricata_GCA_036669905.1'
    lineage             = 'anthozoa_odb12'
    busco_root          = "${projectDir}/../data/busco_refs"          // folder holding the reference busco_<name>/ runs (@BUSCO_ROOT@ in references.tsv)
    busco_download_path = "${projectDir}/../data/busco_downloads"    // offline BUSCO lineage datasets
    phylo_env           = "${System.getenv('HOME')}/miniconda3/envs/phylo"   // conda env with all tools (see README)
    outdir              = "${projectDir}/results"
}

// Every tool is in the local `phylo` env: BUSCO 6.1.0, MAFFT 7.526, trimAl 1.5.1, AMAS 1.0,
// IQ-TREE 3.1.3, ASTER 1.25 (astral4), R with ape/phytools/phangorn.
conda {
    enabled = true
}
process {
    executor = 'local'
    conda    = params.phylo_env
    cpus     = 8
    withName: 'BUSCO_NEW|ALIGN_TRIM|GENE_TREES|CONCAT_TREE' { cpus = 64 }
    withName: 'SHARED_LOCI|PLOT' { cpus = 1 }
}
executor {
    cpus = 256
}
