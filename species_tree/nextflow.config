// Species tree (main.nf). Inputs in a params file:
//   nextflow run main.nf -params-file params/Porites_sp_v1_2.yaml

params {
    name                = null       // tip label of the new genome ([A-Za-z0-9_]+); set in the params file
    fasta               = null       // new assembly; BUSCO is run on it
    busco_dir           = null       // or an existing BUSCO genome-mode output for it
    references          = "${projectDir}/references.tsv"   // name, busco_dir, small, large
    outgroup            = 'Amuricata_GCA_036669905.1'
    lineage             = 'anthozoa_odb12'
    busco_root          = "${projectDir}/../data/busco_refs"          // folder holding the reference busco_<name>/ runs (@BUSCO_ROOT@ in references.tsv)
    busco_download_path = "${projectDir}/../data/busco_downloads"    // offline BUSCO lineage datasets
    outdir              = "${projectDir}/results"
    max_retries         = 3
    trace_report_suffix = java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyy-MM-dd_HH-mm-ss'))   // run reports in <outdir>/pipeline_info/
}

// published results: the output block at the end of main.nf
outputDir            = params.outdir
workflow.output.mode = 'copy'

// Tools: one pinned container per process (main.nf): BUSCO 6.1.0, MAFFT 7.526, trimAl 1.5.1, AMAS 1.0,
// IQ-TREE 3.1.3, ASTER 1.25 (astral4), Python 3.12.13, R 4.5.2 with ape 5.8-1 / phytools 2.5-2 / phangorn 2.12.1.
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/SINGULARITY_CACHE"
}
includeConfig 'process_resources.config'   // cpus / memory / time per process

process {
    executor = 'local'
}

// Retried, with memory and time growing per attempt where process_resources.config scales them: out-of-memory
// kills (137, 104, 247), SIGTERM/time-limit kills (143, 140) and the rest of 130-145, and jobs that left no exit
// status (exit status 2147483647, Integer.MAX_VALUE). Any other failure: 'finish', i.e. no new tasks are submitted but the running ones
// complete.
process {
    errorStrategy = { task.exitStatus in ((130..145).toList() + [104, 247, 2147483647]) ? 'retry' : 'finish' }
    maxRetries    = params.max_retries
}

manifest {
    nextflowVersion = '>=25.04.0'
}

executor {
    cpus = 256
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace_${params.trace_report_suffix}.tsv"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report_${params.trace_report_suffix}.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline_${params.trace_report_suffix}.html"
}

profiles {
    // no Apptainer: the same pinned versions as conda packages (main.nf: conda per process)
    conda {
        conda.enabled     = true
        conda.useMamba    = true
        conda.cacheDir    = "${projectDir}/.conda_envs"
        apptainer.enabled = false
    }
}
