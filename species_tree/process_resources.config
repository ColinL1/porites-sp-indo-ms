/*
 * process_resources.config -- cpus / memory / time per process (withName).
 * memory and time are generous guesses, not measured: the cited run's IQ-TREE steps took at most 30 min and
 * ~1.5 GB. Replace with values from pipeline_info/trace_*.tsv after the next run. Both grow with each retry
 * (nextflow.config: errorStrategy), capped at the workstation by resourceLimits.
 */

process {
    resourceLimits = [cpus: 256, memory: 1000.GB]

    withName: BUSCO_NEW   { cpus = 64; memory = { 64.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: SHARED_LOCI { cpus =  1; memory = {  8.GB * task.attempt }; time = {  2.h * task.attempt } }
    withName: ALIGN_TRIM  { cpus = 64; memory = { 32.GB * task.attempt }; time = {  6.h * task.attempt } }
    withName: CONCAT_TREE { cpus = 64; memory = { 64.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: GENE_TREES  { cpus = 64; memory = { 32.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: ASTRAL      { cpus =  8; memory = { 16.GB * task.attempt }; time = {  4.h * task.attempt } }
    withName: PLOT        { cpus =  1; memory = {  8.GB * task.attempt }; time = {  2.h * task.attempt } }
}
