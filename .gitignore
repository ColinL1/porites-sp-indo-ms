# ---- re-include the small things that ARE tracked ------------------------
# inputs / param tables
!references*.tsv
!genomes*.tsv
!**/params/*.yaml
!**/params/*.yml
!**/configs/*.sh
# small mitogenome inputs (about 19 kb each)
!**/mitogenomes/*.fasta
!**/mitogenomes/README.md
# container recipes and code
!**/containers/*.def
!**/bin/**
bin/__pycache__/
# archived earlier runs: trees, tables, plots and reports only
!**/archive/
!**/archive/**/*.treefile
!**/archive/**/*.contree
!**/archive/**/*.tre
!**/archive/**/*.iqtree
!**/archive/**/partitions.txt
!**/archive/**/commands.sh
!**/archive/**/shared_genes.txt
!**/archive/**/*.tsv
!**/archive/**/*.txt
!**/archive/**/*.md
!**/archive/**/*.MD
!**/archive/**/*.png
!**/archive/**/*.csv.gz
!**/archive/**/*.log
**/archive/**/supermatrix*
**/archive/**/trimmed*/
# small published summary tables of the current analyses
!**/tables/*.tsv
!docs/**

# symlinks to host paths inside archived runs
**/archive/**/logs
**/archive/**/scripts
**/archive/**/source_dir
**/archive/**/trimmed_alignments
