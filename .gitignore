# porites-sp-indo-ms: tracked = code, params, reference tables, docs.
# Not tracked = run outputs, archived runs, data links, genome-sized files.

# ---- archived earlier runs and review leftovers (any depth) ----
archive/
_review*/

# ---- run outputs (any depth) ----
results/
results_*/
refs/
compare_*/
*_work/
_intermediate/
tmp/

# ---- Nextflow ----
work/
.nextflow/
.nextflow.log*
pipeline_info/
trace*.txt
timeline*.html
report*.html
dag*.html
null/

# ---- data: links to GenomeMaker results and external inputs ----
data/*
!data/README.md
genome-assembly-annotation/*
!genome-assembly-annotation/README.md

# ---- genomic and sequencing data ----
*.fa
*.fasta
*.fna
*.faa
*.fai
*.gbk
*.gbff
*.gff
*.gff3
*.gtf
*.fastq
*.fq
*.bam
*.bai
*.cram
*.sam
*.paf
*.vcf
*.bcf
*.tbi
*.csi
*.pod5
*.agp
*.tbl
*.sqn
*.sbt
*.gz
*.zip
*.tar
*.bz2
*.xz
*.zst

# ---- containers and databases ----
*.sif
*.simg
*.dmnd
*.hmm
busco_downloads/

# ---- phylogenetics bulk output ----
supermatrix*
trimmed*/
alignments/
loci/
gene_trees/
*.phy
*.nex
*.ckp.gz
*.bionj
*.mldist
*.ufboot
*.boottrees

# ---- logs ----
*.log
*.out
*.err
logs/
nohup.out
screenlog.*

# ---- language, editor, OS ----
__pycache__/
*.py[cod]
.Rhistory
.RData
.Rproj.user/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- secrets ----
.env
.env.*
*.pem
*.key
*credentials*
.netrc

docs/CLEANUP.md
introgression/docs/*.md
