# porites-sp-indo-ms: tracked = code, params, reference tables, docs.
# Not tracked = run outputs, archived runs, data links, genome-sized files.

# ---- archived earlier runs and review leftovers (any depth) ----
archive/
_review*/

# ---- run outputs (any depth) ----
results/
results_*/
refs/
compare_*/
*_work/
_intermediate/
tmp/

# ---- Nextflow ----
work/
.nextflow/
.nextflow.log*
pipeline_info/
trace*.txt
timeline*.html
report*.html
dag*.html
null/

# ---- data: links to GenomeMaker results and external inputs ----
data/*
!data/README.md
genome-assembly-annotation/*
!genome-assembly-annotation/README.md
!genome-assembly-annotation/porites_binac2.config

# ---- genomic and sequencing data ----
*.fa
*.fasta
*.fna
*.faa
*.fai
*.gbk
*.gbff
*.gff
*.gff3
*.gtf
*.fastq
*.fq
*.bam
*.bai
*.cram
*.sam
*.paf
*.vcf
*.bcf
*.tbi
*.csi
*.pod5
*.agp
*.tbl
*.sqn
*.sbt
*.gz
*.zip
*.tar
*.bz2
*.xz
*.zst

# ---- containers and databases ----
*.sif
*.simg
*.dmnd
*.hmm
busco_downloads/

# ---- phylogenetics bulk output ----
supermatrix*
trimmed*/
alignments/
loci/
gene_trees/
*.phy
*.nex
*.ckp.gz
*.bionj
*.mldist
*.ufboot
*.boottrees

# ---- logs ----
*.log
*.out
*.err
logs/
nohup.out
screenlog.*

# ---- language, editor, OS ----
__pycache__/
*.py[cod]
.Rhistory
.RData
.Rproj.user/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- secrets ----
.env
.env.*
*.pem
*.key
*credentials*
.netrc

# ---- docs folders (any depth): not tracked until cleaned up ----
docs/

# ---- manuscript supplement (built outside the pipelines) ----
supplement_ms/

# ---- plots/: only the scripts are tracked (outputs are rebuilt by run_all.sh) ----
# "<x>/plots/*" ignores the folder's contents, not the folder, so the !scripts/ exception can apply
!genome-assembly-annotation/plots/
genome-assembly-annotation/plots/*
!genome-assembly-annotation/plots/scripts/
comparison/plots/*
!comparison/plots/scripts/
introgression/plots/*
!introgression/plots/scripts/
species_tree/plots/*
!species_tree/plots/scripts/
Rplots.pdf

# ---- Word tables for the manuscript: not tracked yet (the dedicated table scripts and their output) ----
*.docx
shared/plots/tables_docx.R
genome-assembly-annotation/plots/scripts/tables.R
introgression/plots/scripts/tests_table.R
