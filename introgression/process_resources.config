/*
 * process_resources.config -- cpus / memory / time per process (withName).
 * memory = 1.5x and time = 4x the peak / runtime measured in the v1.2 run (results/Porites_sp_v1_2_nf/
 * pipeline_info/trace.tsv), at least 2 GB and 1 h; both grow with each retry (nextflow.config: errorStrategy),
 * capped at the workstation by resourceLimits.
 */

process {
    resourceLimits = [cpus: 256, memory: 1000.GB]

    withName: INPUTS               { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: MAP_READS            { cpus = 256; memory = {  53.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 35.1 GB, 13 min
    withName: CLAIR3               { cpus = 256; memory = { 256.GB * task.attempt }; time = { 5.h * task.attempt } }   // measured 170.2 GB, 68 min
    withName: SNV_FILTER           { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: MOSDEPTH             { cpus =   4; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.4 GB, 1 min
    withName: SPLIT_SNVS           { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.1 GB, 0 min
    withName: PHASE_SCAFFOLD       { cpus =   1; memory = {   3.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 1.7 GB, 14 min
    withName: PHASE_CONCAT         { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: PHASE_STATS_HAPLOTAG { cpus =   8; memory = {   3.GB * task.attempt }; time = { 2.h * task.attempt } }   // measured 1.7 GB, 28 min
    withName: ALIGN_REFERENCE      { cpus =  48; memory = {  60.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 39.5 GB, 8 min
    withName: ANCESTRY_PAINTING    { cpus = 256; memory = {  83.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 54.9 GB, 2 min
    withName: JOINT_VCF            { cpus =   2; memory = {   9.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 5.5 GB, 8 min
    withName: DSUITE               { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 3 min
    withName: GENO                 { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: TWISST               { cpus =   1; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.5 GB, 0 min
    withName: TWISST_PLOT          { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.1 GB, 0 min
    withName: ROBUSTNESS_TREES     { cpus = 256; memory = { 124.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 82.6 GB, 3 min
    withName: TWISST_CELL          { cpus =   1; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.1 GB, 0 min
    withName: ROBUSTNESS_SUMMARY   { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.1 GB, 0 min
    withName: HYDE                 { cpus =   4; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.2 GB, 2 min
    withName: PCA                  { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.1 GB, 0 min
    withName: PLINK_BED            { cpus =   4; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: ADMIXTURE            { cpus =   1; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.1 GB, 0 min
    withName: ADMIXTURE_CV         { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: MITO_READS           { cpus = 256; memory = {  32.GB * task.attempt }; time = { 4.h * task.attempt } }   // not measured (not run in v1.2: mitogenome given)
    withName: MITO_SUBSAMPLE       { cpus =   2; memory = {   4.GB * task.attempt }; time = { 1.h * task.attempt } }   // not measured (not run in v1.2: mitogenome given)
    withName: MITO_FLYE            { cpus =  16; memory = {  32.GB * task.attempt }; time = { 6.h * task.attempt } }   // not measured (not run in v1.2: mitogenome given)
    withName: MITO_SEQUENCES       { cpus =  16; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: MITO_ALIGN           { cpus =   8; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: MITO_TREE            { cpus =  16; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: MITO_SUMMARY         { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
    withName: SUMMARY              { cpus =   2; memory = {   2.GB * task.attempt }; time = { 1.h * task.attempt } }   // measured 0.0 GB, 0 min
}
