// Introgression tests (main.nf). Inputs and panel in a params file:
//   nextflow run main.nf -params-file params/Porites_sp_v1_2.yaml
//   nextflow run main.nf -params-file params/Porites_sp_v1_2.yaml -profile stub -stub   (wiring test)

params {
    new_name            = null      // sample label of the target ([A-Za-z0-9_]+)
    new_fasta           = null      // target assembly
    reads               = null      // ONT reads of the same individual
    agp                 = null      // RagTag AGP of the target (join test); none = skipped
    new_mito            = null      // target mitogenome; none = assembled from the reads (Flye)
    scaffolds           = null      // scaffold set as BED; none = sequences >= min_scaffold_len
    min_scaffold_len    = 10000000
    references          = "${projectDir}/references.tsv"
    ref_dir             = "${projectDir}/../data/introgression_refs"   // NCBI reference FASTAs (@REF_DIR@ in references.tsv)
    mito_bait           = "${projectDir}/mitogenomes/phar_mito_bait_CM137701.fasta"   // P. harrisoni mito contig used to find mito reads/contigs
    mito_root           = 'Pdivaricata2'
    robustness_outgroup = null      // none = first outgroup in references.tsv
    clair3_model        = '/usr/local/bin/models/r1041_e82_400bps_sup_v520'   // inside the Clair3 image
    tools_container     = "${System.getenv('HOME')}/SINGULARITY_CACHE/introgression_tools_1.0.sif"
    max_cpus            = 256
    outdir              = "${projectDir}/results/${params.new_name}_nf"
}

// published results: the output block at the end of main.nf
outputDir            = params.outdir
workflow.output.mode = 'copy'

process {
    executor = 'local'
    cpus     = 2
    errorStrategy = 'terminate'
}

executor {
    cpus = 256
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/SINGULARITY_CACHE"
}

profiles {
    // -stub wiring test: no containers, tiny resources
    stub {
        apptainer.enabled = false
        executor.cpus     = 4
        // a selector, not process.cpus: processes declare their own cpus, which beat the default
        process {
            withName: '.*' { cpus = 1 }
        }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
