# Tools without a BioContainers image, pinned to the versions of the canu_lut_rag run
# (the `introgress` conda env and the checkouts in assembly/Introgression/scripts/), plus the
# Python packages of nf/bin/, plus minimap2 / samtools / bcftools / htslib for the steps that
# pipe them together (no BioContainers image combines these versions).
#
#   apptainer build --fakeroot ~/SINGULARITY_CACHE/introgression_tools_1.0.sif introgression_tools.def
#
# Dsuite 0.5 r58 (a547f99), HyDe / phyde 1.0.2, Twisst (a5e1003), genomics_general (3924344),
# FastTree 2.2.0, minimap2 2.31 (with paftools.js), samtools 1.24, bcftools 1.24, htslib 1.24,
# Python 3.10 with pysam 0.24.1, numpy 2.2.6, matplotlib 3.10.9,
# DendroPy 5.0.13, ete3 3.1.3.
Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%post
    set -eu
    micromamba install -y -n base -c conda-forge -c bioconda \
        python=3.10 numpy=2.2.6 matplotlib-base=3.10.9 pysam=0.24.1 dendropy=5.0.13 \
        ete3=3.1.3 six=1.17.0 fasttree=2.2.0 cython=3.3.0 \
        minimap2=2.31 samtools=1.24 bcftools=1.24 htslib=1.24 \
        cxx-compiler make zlib git pip procps-ng
    micromamba clean -a -y
    export PATH=/opt/conda/bin:$PATH
    pip install --no-cache-dir phyde==1.0.2 progress==1.6.1 multiprocess==0.70.19

    mkdir -p /opt/src && cd /opt/src
    git clone https://github.com/millanek/Dsuite.git && cd Dsuite && git checkout a547f99599d763c1760548191ea3f62cc58e8ac3
    make CXX="x86_64-conda-linux-gnu-g++ -I/opt/conda/include -L/opt/conda/lib -Wl,-rpath,/opt/conda/lib"
    cp Build/Dsuite /opt/conda/bin/
    cd /opt/src
    git clone https://github.com/simonhmartin/twisst.git && (cd twisst && git checkout a5e10034f14c7bb027a2760a5804446cc7f39f76)
    # the one local change of the canu run's checkout: np.NaN was removed in NumPy 2
    sed -i 's/else np.NaN$/else np.nan/' twisst/twisst.py
    grep -q 'else np.nan$' twisst/twisst.py
    git clone https://github.com/simonhmartin/genomics_general.git && (cd genomics_general && git checkout 39243440565d138f3eedd1f99b62916254706f71)
    rm -rf /opt/src/*/.git

%environment
    export PATH=/opt/conda/bin:$PATH
    export TWISST=/opt/src/twisst/twisst.py
    export PARSEVCF=/opt/src/genomics_general/VCF_processing/parseVCF.py
    export MPLCONFIGDIR=/tmp

%test
    export PATH=/opt/conda/bin:$PATH
    python -c "import pysam, numpy, matplotlib, dendropy, ete3, phyde"
    Dsuite 2>&1 | grep -q "0.5 r58"
    FastTree 2>&1 | head -1 | grep -q "2.2.0"
    minimap2 --version | grep -q "^2.31"
    samtools --version | grep -q "samtools 1.24"
    bcftools --version | grep -q "bcftools 1.24"
    paftools.js version > /dev/null
    run_hyde.py -h > /dev/null
    python /opt/src/twisst/twisst.py -h > /dev/null
    ps --version > /dev/null

%labels
    Description Dsuite, HyDe, Twisst, genomics_general and the Python of the introgression tests
    Version 1.0
