/*
 * process_resource.config -- cpus / memory / time per process (withName).
 * Values of the stage-08 processes are those of GenomeMaker/process_resource.config, with the same
 * params names (nextflow.config); the comparison's own processes carry the numbers they had.
 * Every process retries on out-of-memory / fatal-signal exit codes with attempt-scaled resources.
 */

process {
    withName: NCBI_DOWNLOAD          { cpus = 1; memory = { 4.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: PREP_REF_ANNOTATION    { cpus = 4; memory = { 32.GB * task.attempt }; time = { 6.h * task.attempt } }
    withName: DROP_UNTRANSLATABLE    { cpus = 2; memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: EXTRACT_PROTEINS       { cpus = 4; memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: FUNANNOTATE_GENE_IDS   { cpus = 1; memory = { 4.GB * task.attempt };  time = { 1.h * task.attempt } }

    withName: PHOBIUS_RUN            { cpus = { 4 * task.attempt }; memory = { 8.GB * task.attempt }; time = { 4.h * task.attempt } }
    withName: INTERPROSCAN           { cpus = { params.threads_interproscan * task.attempt }; memory = { params.resource_iprscan_memory * task.attempt }; time = { params.resource_iprscan_time * task.attempt } }
    withName: EGGNOG_MAPPER          { cpus = { params.threads_funannotate * task.attempt }; memory = { params.resource_eggnog_memory * task.attempt }; time = { params.resource_eggnog_time * task.attempt } }
    withName: FUNANNOTATE_ANNOTATE   { cpus = { params.threads_funannotate_annotate * task.attempt }; memory = { params.resource_funannotate_memory * task.attempt }; time = { params.resource_funannotate_time * task.attempt } }

    // proteinortho's all-vs-all search is the parallel part: the run has the node to itself
    withName: FUNANNOTATE_COMPARE    { cpus = { params.compare_cpus }; memory = { params.resource_compare_memory * task.attempt }; time = { params.resource_compare_time * task.attempt } }
}
