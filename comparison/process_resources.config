/*
 * process_resources.config -- cpus / memory / time per process (withName).
 * Values of the stage-08 processes are those of GenomeMaker/process_resource.config; the
 * comparison's own processes carry the numbers they had.
 * Every process retries on out-of-memory / fatal-signal exit codes with attempt-scaled resources.
 */

process {
    withName: NCBI_DOWNLOAD          { cpus = 1; memory = { 4.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: PREP_REF_ANNOTATION    { cpus = 4; memory = { 32.GB * task.attempt }; time = { 6.h * task.attempt } }
    withName: DROP_UNTRANSLATABLE    { cpus = 2; memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: EXTRACT_PROTEINS       { cpus = 4; memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: FUNANNOTATE_GENE_IDS   { cpus = 1; memory = { 4.GB * task.attempt };  time = { 1.h * task.attempt } }

    withName: PHOBIUS_RUN            { cpus = { 4 * task.attempt }; memory = { 8.GB * task.attempt }; time = { 4.h * task.attempt } }
    withName: INTERPROSCAN           { cpus = { 240 * task.attempt }; memory = { 200.GB * task.attempt }; time = { 48.h * task.attempt } }
    withName: EGGNOG_MAPPER          { cpus = { 128 * task.attempt }; memory = { 200.GB * task.attempt }; time = { 24.h * task.attempt } }
    withName: FUNANNOTATE_ANNOTATE   { cpus = { 240 * task.attempt }; memory = { 200.GB * task.attempt }; time = { 48.h * task.attempt } }

    // proteinortho's all-vs-all search is the parallel part: the run has the node to itself (capped by resourceLimits on BinAC 2)
    withName: PROTEINORTHO_NOSYNTENY { cpus = 240; memory = { 256.GB * task.attempt }; time = { 96.h * task.attempt } }
    withName: FUNANNOTATE_COMPARE    { cpus = 240; memory = { 256.GB * task.attempt }; time = { 96.h * task.attempt } }
}
