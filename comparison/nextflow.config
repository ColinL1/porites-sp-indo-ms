/*
 * Comparison of the new Porites genome with the annotated NCBI Porites (main.nf).
 *
 * Process settings (containers, resources, profiles: local / binac2 / conda) are those of the
 * GenomeMaker pipeline, read through the link ../data/GenomeMaker (see ../data/README.md).
 * Only what depends on projectDir is redirected below, because projectDir is this folder here.
 */

includeConfig '../data/GenomeMaker/nextflow.config'

params {
    // stage-08 databases live in GenomeMaker/config
    funannotate_db    = "${projectDir}/../data/GenomeMaker/config/funannotate_DB"
    eggnog_db         = "${projectDir}/../data/GenomeMaker/config/eggnog_DB"
    phobius_dir       = "${projectDir}/../data/GenomeMaker/config/phobius"
    busco_offline_dir = "${projectDir}/../data/GenomeMaker/config/busco_db"

    // main.nf
    step                 = null
    ref_fasta            = null
    ref_gff              = null
    compare_gbks         = null
    compare_proteinortho = null   // precomputed ProteinOrtho table (run without -synteny)
    compare_num_orthos   = 500
    compare_cpus         = 240
    drop_untranslatable  = true   // false only to resume the P. harrisoni annotation (made before DROP_UNTRANSLATABLE existed)
}
