// Comparison of the new Porites genome with other annotated genomes (main.nf). Inputs in a params file:
//   nextflow run main.nf -params-file params/Porites_sp_v1_2.yaml
//   nextflow run main.nf -params-file params/Porites_sp_v1_2.yaml -profile stub -stub          (wiring test)
//   nextflow run main.nf -params-file params/Porites_sp_v1_2_binac2.yaml -profile binac2       (BinAC 2)
//
// Per-process cpus / memory / time: process_resources.config.

includeConfig 'process_resources.config'

params {
    // ---- genomes: list of { name, accession } or { name, fasta, gff }; set in the params file
    genomes              = []
    compare_gbks         = []       // ready-made funannotate GenBank files added to the compare

    // ---- databases (set in the params file)
    funannotate_db       = null
    eggnog_db            = null
    phobius_dir          = null     // licensed Phobius directory
    run_phobius          = true
    interproscan_container = 'interpro/interproscan:5.73-104.0'
    interproscan_data    = null     // data dir matching interproscan_container; null (and no interproscan_dir) = InterProScan skipped
    interproscan_dir     = null     // local InterProScan install instead of the container
    funannotate_busco_db = 'metazoa'
    funannotate_force    = false    // funannotate annotate --force: keep scaffolds using fewer than 4 bases

    // ---- gene models
    drop_untranslatable  = true     // false only to resume an annotation made before this step existed

    // ---- funannotate compare
    compare_synteny      = true     // ProteinOrtho with -synteny; false needs compare_proteinortho
    compare_proteinortho = null     // precomputed ProteinOrtho table (made without -synteny)
    compare_num_orthos   = 500

    // ---- run
    max_retries          = 3
    project              = null     // BinAC 2 account (sbatch -A)
    apptainer_cache_dir  = "/pfs/10/project/apptainer_cache/${System.getenv('USER')}"   // BinAC 2
    outdir               = "${projectDir}/results"
    trace_report_suffix  = java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyy-MM-dd_HH-mm-ss'))
}

// published results: the output block at the end of main.nf
outputDir            = params.outdir
workflow.output.mode = 'copy'

// Retried, with memory and time growing per attempt (process_resources.config): out-of-memory kills
// (137, 104, 247), SIGTERM/time-limit kills (143, 140) and the rest of 130-145, and jobs that left no exit
// status (exit status 2147483647, Integer.MAX_VALUE, e.g. SLURM killed the job hard). Any other failure: 'finish', i.e. no new
// tasks are submitted but the running ones (e.g. InterProScan) complete.
process {
    errorStrategy = { task.exitStatus in ((130..145).toList() + [104, 247, 2147483647]) ? 'retry' : 'finish' }
    maxRetries    = params.max_retries
}

manifest {
    nextflowVersion = '>=25.04.0'
}

// conda environments of the modules (profile conda): mamba, packages pinned in each module
conda {
    useMamba = true
}

// default: local workstation (256 threads), containers via Apptainer (as species_tree and introgression)
process.executor = 'local'
executor.cpus    = 256
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/SINGULARITY_CACHE"
}

profiles {
    // BinAC 2: SLURM + Apptainer. Paths and the account come from the params file.
    binac2 {
        process {
            executor       = 'slurm'
            clusterOptions = { params.project ? "-A ${params.project}" : "-p compute" }
            queue          = 'compute'
            resourceLimits = [
                memory: 2000.GB,
                cpus:   128,
                time:   336.h
            ]
        }
        executor {
            queueSize         = 200
            submitRateLimit   = '50/2min'
            pollInterval      = 10.s
            queueStatInterval = 1.m
        }
        apptainer {
            enabled     = true
            autoMounts  = true
            pullTimeout = 40.m
            cacheDir    = params.apptainer_cache_dir
        }
    }

    // no Apptainer: tools from the pinned conda packages
    conda {
        process.executor = 'local'
        executor.cpus    = 256
        conda.enabled    = true
        conda.cacheDir   = "${projectDir}/.conda_envs"
        apptainer.enabled = false
    }

    // -stub wiring test: no containers, tiny resources
    stub {
        apptainer.enabled = false
        executor.cpus     = 4
        process.executor  = 'local'
        // a selector, not process.cpus: processes declare their own cpus, which beat the default
        process {
            withName: '.*' {
                cpus   = 1
                memory = 1.GB
                time   = 10.m
            }
            errorStrategy = 'terminate'
        }
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace_${params.trace_report_suffix}.tsv"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report_${params.trace_report_suffix}.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline_${params.trace_report_suffix}.html"
}
